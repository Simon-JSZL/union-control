<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.union.control.sensitive.demo.SensitiveDemoMapper">
    <insert id="insert" parameterType="com.union.control.sensitive.demo.SensitiveDemoRecord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sensitive_data_demo (user_id,encrypted_content,delete_flag)
        VALUES (#{userId},#{content},1)
    </insert>

    <select id="list" resultType="com.union.control.sensitive.demo.SensitiveDemoRecord">
        SELECT id,encrypted_content AS content,
               DATE_FORMAT(created_at,'%Y-%m-%dT%H:%i:%s') AS createdAt
        FROM sensitive_data_demo
        WHERE user_id=#{userId} AND delete_flag=1
        ORDER BY id DESC LIMIT 100
    </select>
</mapper>
